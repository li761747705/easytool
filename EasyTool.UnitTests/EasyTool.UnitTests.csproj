<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<SuppressTfmSupportBuildErrors>true</SuppressTfmSupportBuildErrors>
		<LangVersion>latest</LangVersion>
		<Nullable>annotations</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>EasyTool.UnitTests</RootNamespace>

		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="6.0.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EasyTool.Core\EasyTool.Core.csproj" />
		<ProjectReference Include="..\EasyTool.Media\EasyTool.Media.csproj" />
		<ProjectReference Include="..\EasyTool.AI\EasyTool.AI.csproj" />
		<ProjectReference Include="..\EasyTool.System\EasyTool.System.csproj" />
		<ProjectReference Include="..\EasyTool.All\EasyTool.All.csproj" />
	</ItemGroup>

</Project>